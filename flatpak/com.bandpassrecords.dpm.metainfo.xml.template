<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 BandPass Records -->
<component type="desktop-application">
  <id>com.bandpassrecords.dpm</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>DAW Project Manager</name>
  <summary>Track and organize your DAW projects across every studio</summary>
  <description>
    <p>
      DAW Project Manager scans your drives for music production projects —
      Ableton Live, Cubase, FL Studio, Logic Pro, Bitwig, Pro Tools, Reaper,
      Studio One, and over twenty other DAWs — and keeps them organized in one
      dashboard.
    </p>
    <p>
      Track project phases and deadlines, tag releases, manage a task queue
      per project, sync your library across machines with Google Drive, and
      browse everything with filtering, search, and playlists for quick
      A/B listening.
    </p>
  </description>

  <launchable type="desktop-id">com.bandpassrecords.dpm.desktop</launchable>

  <!--
    NOTE: resources/screenshots/dashboard/dashboard-bulk-actions.png,
    dashboard-customize-tabs.png, and dashboard-filters-search.png are still
    0-byte placeholders (see resources/screenshots/README.md) — fine for now
    since nothing below references them, but don't add a <screenshot> for one
    of them without replacing it with a real capture first; Flathub's
    validator fetches these URLs and rejects the submission on a broken image.
  -->
  <screenshots>
    <screenshot type="default">
      <caption>Dashboard overview with projects across multiple DAWs</caption>
      <image>https://raw.githubusercontent.com/bandpassrecords/daw-project-manager/@GIT_TAG@/resources/screenshots/dashboard/dashboard-overview.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://dpm.bandpassrecords.com</url>
  <url type="bugtracker">https://github.com/bandpassrecords/daw-project-manager/issues</url>
  <url type="vcs-browser">https://github.com/bandpassrecords/daw-project-manager</url>

  <developer id="com.bandpassrecords">
    <name>BandPass Records</name>
  </developer>

  <content_rating type="oars-1.1" />

  <releases>
    <!--
      This entry is regenerated from @APP_VERSION@/@GIT_TAG@/@RELEASE_DATE@
      on every build (see the daw-project-manager module's build-commands in
      com.bandpassrecords.dpm.yml), so it always matches whatever tag the
      build is pinned to — nothing to bump here for the *current* release.
      What's still manual: once a release actually ships on Flathub, freeze
      that version's entry with its real values (copy them from a build log,
      or from `flatpak run com.bandpassrecords.dpm.metainfo.xml` if you have
      the built one handy) as a new hardcoded <release> block above this one,
      so the changelog accumulates instead of only ever showing the latest.
    -->
    <release version="@APP_VERSION@" date="@RELEASE_DATE@">
      <description>
        <p>See the GitHub release notes for details.</p>
      </description>
      <url>https://github.com/bandpassrecords/daw-project-manager/releases/tag/@GIT_TAG@</url>
    </release>
  </releases>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <recommends>
    <display_length compare="ge">1080</display_length>
  </recommends>
</component>
