<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification icon — monochrome version of the app icon.
  Three diagonal bands (matching the launcher icon geometry) rendered
  as white fills at decreasing opacity on a transparent background.
  Android tints the non-transparent pixels with the notification accent colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Top-left band (maps to the orange region) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M0,0 L24,0 L24,7 L0,18 Z" />

    <!-- Middle band (maps to the grey stripe) -->
    <path
        android:fillColor="#99FFFFFF"
        android:pathData="M0,18 L24,7 L24,13 L0,24 Z" />

    <!-- Bottom-right band (maps to the dark navy region) -->
    <path
        android:fillColor="#55FFFFFF"
        android:pathData="M0,24 L24,13 L24,24 Z" />

</vector>
